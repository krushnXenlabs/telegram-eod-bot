# ─────────────────────────────────────────────────────────
# EOD Bot — Environment Variables
# Copy this file to .env and fill in your real values
# ─────────────────────────────────────────────────────────

# 1. Get this from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Get this from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# 3. Your personal Telegram User ID
#    → Start the bot and send /start — it will print your ID
#    → Or message @userinfobot on Telegram
TELEGRAM_USER_ID=123456789

# 4. Imgur Client ID (for photo uploads - free)
#    Go to https://api.imgur.com/oauth2/addclient
#    Choose "Anonymous usage without user authorization"
#    Copy the Client ID (not the secret)
IMGUR_CLIENT_ID=your_imgur_client_id_here

# 5. Supabase (for analytics - optional but recommended)
#    Go to https://supabase.com → New project → Settings → API
#    Copy "Project URL" and "anon public" key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# 6. Obsidian vault (optional - for rich daily notes synced via GitHub)
#    Set this to the path of your cloned Obsidian vault on the VM
#    e.g. /home/krushn/obsidian-vault
OBSIDIAN_VAULT_PATH=/home/krushn/obsidian-vault
#    Subfolder inside the vault where daily notes live (default: Daily Notes)
OBSIDIAN_DAILY_NOTES_DIR=Daily Notes
